#!/bin/sh
# Score the staged blobs of markdown and text files, not the working tree.
# did the work: the checker ran on staged .md and .txt files.
# had no work: no staged file of those types.
# could not do it: git is missing, the checker could not be found, a staged
# blob could not be read, or the checker returned a status other than 0 or 1.

set -eu

case $0 in
  /*) hook_arg=$0 ;;
  *) hook_arg="$(pwd)/$0" ;;
esac

if ! command -v git >/dev/null 2>&1 || ! command -v python3 >/dev/null 2>&1; then
  echo "writing-check: could not do it" >&2
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "writing-check: could not do it" >&2
  exit 0
}
cd "$root" || {
  echo "writing-check: could not do it" >&2
  exit 0
}

if [ -n "${WRITING_CHECK:-}" ] && [ -f "$WRITING_CHECK" ]; then
  check=$WRITING_CHECK
elif [ -n "${WRITING_CHECK:-}" ]; then
  echo "writing-check: could not do it (checker not found)" >&2
  exit 0
else
  hook_real=$(python3 -I -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$hook_arg") || {
    echo "writing-check: could not do it" >&2
    exit 0
  }
  hook_dir=$(dirname -- "$hook_real")
  if [ -f "$hook_dir/writing_check.py" ]; then
    check=$hook_dir/writing_check.py
  elif [ -f "$root/writing_check.py" ]; then
    check=$root/writing_check.py
  else
    check=$(command -v writing_check.py 2>/dev/null || true)
    if [ -z "$check" ] || [ ! -f "$check" ]; then
      echo "writing-check: could not do it (checker not found)" >&2
      exit 0
    fi
  fi
fi

list_file=$(mktemp "${TMPDIR:-/tmp}/writing-check.XXXXXX")
trap 'rm -f "$list_file"' EXIT
lines_file=$(mktemp "${TMPDIR:-/tmp}/writing-check.XXXXXX")
trap 'rm -f "$list_file" "$lines_file"' EXIT
blob=$(mktemp "${TMPDIR:-/tmp}/writing-check.XXXXXX")
trap 'rm -f "$list_file" "$lines_file" "$blob"' EXIT

git diff --cached --name-only -z --diff-filter=ACMR > "$list_file" || {
  echo "writing-check: could not do it" >&2
  exit 0
}
tr '\0' '\n' < "$list_file" > "$lines_file"

scored=0
fail=0
max=${WRITING_CHECK_MAX:-15}
while IFS= read -r path || [ -n "$path" ]; do
  [ -n "$path" ] || continue
  case "$path" in
    *.md|*.txt) ;;
    *) continue ;;
  esac
  if ! git show ":$path" > "$blob"; then
    echo "writing-check: could not do it ($path)" >&2
    continue
  fi
  if [ "$scored" -eq 0 ]; then
    echo "writing-check: did the work" >&2
  fi
  scored=1
  set +e
  python3 -I "$check" --max "$max" --stdin --label="$path" < "$blob"
  status=$?
  set -e
  if [ "$status" -eq 1 ]; then
    fail=1
  elif [ "$status" -ne 0 ]; then
    echo "writing-check: could not do it ($path)" >&2
  fi
done < "$lines_file"

if [ "$scored" -eq 0 ]; then
  echo "writing-check: had no work" >&2
  exit 0
fi
exit "$fail"
